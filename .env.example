# =============================================================================
# RevenueFlow — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# =============================================================================

# PostgreSQL connection string
# AVISO: O build Next.js v15.5+ necessita validar dependencias. Se um banco
# ativo não estiver disponivel no host local em tempo de dev/build, o Better Auth 
# logara warnings "Drizzle schema mismatch". Use um banco local ou Neon.tech.
DATABASE_URL=postgresql://user:password@localhost:5432/revenueflow

# Better Auth secret key — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Application base URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000